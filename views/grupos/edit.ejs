<%- include('../partials/header') %>

<div class="page-header">
  <h1>Editar Grupo de Atendimento</h1>
  <a href="/grupos" class="btn btn-secondary">← Voltar</a>
</div>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<form action="/grupos/<%= grupo.id %>" method="POST" class="form-card">
  <div class="form-group">
    <label for="nome">Nome do Grupo *</label>
    <input type="text" id="nome" name="nome" value="<%= grupo.nome %>" required autofocus>
  </div>
  <div class="form-group">
    <label for="descricao">Descrição</label>
    <textarea id="descricao" name="descricao" rows="3"><%= grupo.descricao || '' %></textarea>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
    <a href="/grupos" class="btn btn-secondary">Cancelar</a>
  </div>
</form>

<%- include('../partials/footer') %>
