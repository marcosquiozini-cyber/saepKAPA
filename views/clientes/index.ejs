<%- include('../partials/header') %>

<div class="page-header">
  <h1>Clientes / Responsáveis</h1>
  <a href="/clientes/novo" class="btn btn-primary">+ Novo Cliente</a>
</div>

<% if (success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<!-- Filtro de busca (RF05) -->
<form action="/clientes" method="GET" class="search-form">
  <div class="search-group">
    <input type="text" name="busca" value="<%= busca || '' %>"
           placeholder="Buscar por nome do responsável..." class="search-input">
    <button type="submit" class="btn btn-primary">Buscar</button>
    <% if (busca) { %>
      <a href="/clientes" class="btn btn-secondary">Limpar</a>
    <% } %>
  </div>
</form>

<% if (busca) { %>
  <p class="search-info">Resultados para: <strong>"<%= busca %>"</strong> (<%= clientes.length %> encontrado(s))</p>
<% } %>

<% if (clientes.length === 0) { %>
  <div class="empty-state">
    <% if (busca) { %>
      <p>Nenhum cliente encontrado com o termo "<%= busca %>".</p>
      <a href="/clientes" class="btn btn-secondary">Ver todos</a>
    <% } else { %>
      <p>Nenhum cliente cadastrado ainda.</p>
      <a href="/clientes/novo" class="btn btn-primary">Cadastrar primeiro cliente</a>
    <% } %>
  </div>
<% } else { %>
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome Completo</th>
          <th>CPF</th>
          <th>E-mail</th>
          <th>Telefone</th>
          <th>Grupo</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% clientes.forEach(cliente => { %>
          <tr>
            <td><%= cliente.id %></td>
            <td><strong><%= cliente.nome_completo %></strong></td>
            <td><%= cliente.cpf %></td>
            <td><%= cliente.email || '—' %></td>
            <td><%= cliente.telefone || '—' %></td>
            <td>
              <span class="badge"><%= cliente.grupo_nome || '—' %></span>
            </td>
            <td class="actions">
              <a href="/clientes/<%= cliente.id %>/editar" class="btn btn-sm btn-secondary">Editar</a>
              <form action="/clientes/<%= cliente.id %>/excluir" method="POST" class="inline-form"
                    onsubmit="return confirm('Tem certeza que deseja excluir o cliente <%= cliente.nome_completo %>?');">
                <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
