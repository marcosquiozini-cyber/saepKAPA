<%- include('../partials/header') %>

<div class="login-wrapper">
  <div class="login-card">
    <div class="login-header">
      <h1>🏥 Pequenos Passos</h1>
      <p>Gestão de Clientes e Grupos de Atendimento</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/login" method="POST" class="login-form">
      <div class="form-group">
        <label for="cpf">CPF</label>
        <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" required autofocus>
      </div>
      <div class="form-group">
        <label for="senha">Senha</label>
        <input type="password" id="senha" name="senha" placeholder="Digite sua senha" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Entrar</button>
    </form>

    <div class="login-hint">
      <small>Credenciais de teste: CPF <strong>000.000.000-00</strong> | Senha <strong>admin123</strong></small>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
